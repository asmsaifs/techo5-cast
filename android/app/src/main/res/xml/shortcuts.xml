<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Each saved Show is a dynamic shortcut in this category: it appears in the share sheet's top row. -->
    <share-target android:targetClass="dev.techo5.cast.app.IntakeActivity">
        <data android:mimeType="text/plain" />
        <data android:mimeType="video/*" />
        <data android:mimeType="audio/*" />
        <category android:name="dev.techo5.cast.category.SHOW" />
    </share-target>
</shortcuts>
